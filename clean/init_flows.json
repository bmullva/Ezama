    {
        "id": "a1b2c3d4e5f67890",
        "type": "function",
        "z": "c384410fdb810ed6",
        "name": "Filter On/Off",
        "func": "// Filter incoming messages: only pass through if payload is \"on\", \"off\", or \"click\"\nvar allowedValues = [\"on\", \"off\", \"click\"];\n\nif (allowedValues.indexOf(msg.payload) !== -1) {\n    // Match found: pass the message through unchanged\n    return msg;\n} else {\n    // No match: discard silently (no output)\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
